{
  "name": "bibleberry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:r06": "VITE_ENABLE_R06_SHELL=true VITE_ENABLE_RELEASE_GATEWAY_SOURCE=true vite",
    "dev:pilot": "VITE_ENABLE_CHALLENGE_PILOT=true vite",
    "dev:participation-pilot": "VITE_ENABLE_PARTICIPATION_PILOT=true vite",
    "dev:released-challenge": "VITE_ENABLE_RELEASED_CHALLENGE_ROUTE=true vite",
    "dev:gateway-challenge": "VITE_ENABLE_RELEASED_CHALLENGE_ROUTE=true VITE_ENABLE_RELEASE_GATEWAY_SOURCE=true vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:adapter": "node --experimental-strip-types --test tests/sanity/*.test.ts",
    "test:gateway": "node --experimental-strip-types --test tests/gateway/*.test.ts",
    "test:native-participation": "node --experimental-strip-types --test tests/participation/*.test.ts",
    "test:shelf-persistence": "node --experimental-strip-types --test tests/shelfPersistence/*.test.ts",
    "test:reader-profile": "node --experimental-strip-types --test tests/readerProfile/*.test.ts",
    "test:reader-shell": "node --experimental-strip-types --test tests/readerShell/*.test.ts",
    "test:library-shelf": "node --experimental-strip-types --test tests/libraryShelf/libraryShelfModel.test.ts && playwright test --config tests/libraryShelf/playwright.config.ts",
    "test:performance": "node --experimental-strip-types --test tests/performance/*.test.ts",
    "test:collections": "node scripts/testing/run-collections-browser-tests.mjs",
    "test:smoke": "node --experimental-strip-types scripts/run-smoke-suite.ts",
    "perf:baseline": "node --experimental-strip-types scripts/performance-baseline.ts",
    "perf:compare": "node --experimental-strip-types scripts/performance/compare-r21-baselines.ts",
    "fixtures:staging": "node --experimental-strip-types scripts/staging-fixtures.ts",
    "verify:staging": "node --experimental-strip-types scripts/verify-staging-acceptance.ts",
    "check:staging": "wrangler deploy --dry-run --config wrangler.staging.jsonc",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@portabletext/react": "^7.0.1",
    "lucide-react": "^0.562.0",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wrangler": "^4.158.0"
  }
}
